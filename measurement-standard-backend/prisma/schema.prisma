// Prisma schema for the measurement-standard-backend project.
// Mirrors the previous TypeORM entities 1:1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
  super_admin
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  username        String
  email           String         @unique
  password_hash   String?
  created_at      DateTime       @default(now()) @db.Timestamp(6)
  profile_picture String?
  role            Role           @default(user)
  refresh_token   String?
  progress        UserProgress[]
  responses       UserResponse[]
  testSessions    TestSession[]
  favorites       Favorite[]
  notifications   Notification[]

  @@map("users")
}

model UserProgress {
  id               String    @id @default(uuid()) @db.Uuid
  user_id          String    @db.Uuid
  user             User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  overall_score    Decimal   @default(0) @db.Decimal(5, 2)
  tests_completed  Int       @default(0)
  last_active_date DateTime? @db.Date

  @@map("user_progress")
}

model ExamType {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  code         String        @unique @db.VarChar(100)
  sections     Section[]
  testSessions TestSession[]

  @@map("exam_types")
}

model Section {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  exam_type_id String     @db.Uuid
  examType     ExamType   @relation(fields: [exam_type_id], references: [id], onDelete: Cascade)
  questions    Question[]

  @@map("sections")
}

model Question {
  id          String         @id @default(uuid()) @db.Uuid
  content     String         @db.Text
  explanation String?        @db.Text
  created_at  DateTime       @default(now()) @db.Timestamp(6)
  section_id  String         @db.Uuid
  section     Section        @relation(fields: [section_id], references: [id], onDelete: Cascade)
  choices     Choice[]
  responses   UserResponse[]
  favorites   Favorite[]

  @@map("questions")
}

model Choice {
  id            String         @id @default(uuid()) @db.Uuid
  content       String
  is_correct    Boolean        @default(false)
  question_id   String         @db.Uuid
  question      Question       @relation(fields: [question_id], references: [id], onDelete: Cascade)
  userResponses UserResponse[] @relation("SelectedChoice")

  @@map("choices")
}

model TestSession {
  id              String         @id @default(uuid()) @db.Uuid
  user_id         String         @db.Uuid
  user            User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  exam_type_id    String?        @db.Uuid
  examType        ExamType?      @relation(fields: [exam_type_id], references: [id], onDelete: SetNull)
  score           Int
  total_questions Int
  created_at      DateTime       @default(now()) @db.Timestamp(6)
  responses       UserResponse[]

  @@map("test_sessions")
}

model UserResponse {
  id                 String       @id @default(uuid()) @db.Uuid
  user_id            String       @db.Uuid
  user               User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  question_id        String       @db.Uuid
  question           Question     @relation(fields: [question_id], references: [id], onDelete: Cascade)
  selected_choice_id String?      @db.Uuid
  selectedChoice     Choice?      @relation("SelectedChoice", fields: [selected_choice_id], references: [id], onDelete: SetNull)
  test_session_id    String?      @db.Uuid
  session            TestSession? @relation(fields: [test_session_id], references: [id], onDelete: SetNull)
  is_correct         Boolean
  answered_at        DateTime     @default(now()) @db.Timestamp(6)
  created_at         DateTime     @default(now()) @db.Timestamp(6)

  @@unique([user_id, question_id], name: "IDX_USER_RESPONSE_USER_QUESTION")
  @@map("user_responses")
}

model Favorite {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  question_id String   @db.Uuid
  question    Question @relation(fields: [question_id], references: [id], onDelete: Cascade)
  created_at  DateTime @default(now()) @db.Timestamp(6)

  @@map("favorites")
}

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title      String
  message    String    @db.Text
  is_read    Boolean   @default(false)
  type       String?
  url        String?
  data       Json?
  created_at DateTime  @default(now()) @db.Timestamp(6)
  expires_at DateTime? @db.Timestamp(6)

  @@index([created_at])
  @@index([expires_at])
  @@map("notifications")
}
